{
  "name": "Reelbook: Filmmaker's Notebook",
  "short_name": "Reelbook",
  "description": "Shot lists, storyboards, palettes, slate, take log and post workflow for filmmakers.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0e0f12",
